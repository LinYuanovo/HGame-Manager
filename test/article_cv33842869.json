          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "再之后选项就是全员内，这样的话就是直接到完美结局；如果说是没有全员内或者在一开始和志摩选择了内(一开始就被催眠)，则会触发",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "BADEND",
                    "font_size": 17,
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，无法逃脱志摩的催眠控制。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "\n",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "经过数次轮回，主角终于算是反杀了志摩，但只要选错一步，那不是蹲大牢就是落得和上一任教主的下场——被催眠控制然后炸☝干。总之剧情也挺简单，没啥可分析的。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
