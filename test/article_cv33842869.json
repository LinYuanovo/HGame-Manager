          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "由兽人社ORCSOFT制作的一款纯拔作SLG。英文名My Life as a Cult Leader。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "游戏结局一共5个，流程不是很长，但特殊的 ",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "多周目 ",
                    "font_size": 17,
                    "color": "#60d837",
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "玩法却很有意思。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 3,
            "format": {
              "align": 1
            },
            "line": {
              "pic": {
                "url": "//i0.hdslb.com/bfs/article/0117cbba35e51b0bce5f8c2f6a838e8a087e8ee7.png"
              }
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "好，攻略开始了哈",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "\n",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "多周目",
                    "font_size": 17,
                    "color": "#02a2ff",
                    "style": {
                      "bold": true
                    }
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "\n",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "一开始玩会很迷，上来选完后，根本不知道发生了什么就直接GG了。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "实际上，回到主菜单界面后，选择 '新游戏' 则会触发",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "下一周目",
                    "font_size": 17,
                    "color": "#ff654e",
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，而如果通过LOAD存档溯回则还是会停留在存档周目。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 6,
            "format": {
              "list_format": {
                "level": 1,
                "order": 1
              }
            },
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "第一周目是一定会GG的 ",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "因为毕竟是轮回嘛，不GG怎么轮回",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 6,
            "format": {
              "list_format": {
                "level": 1,
                "order": 2
              }
            },
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "第二周目则在开始时和",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "志摩",
                    "font_size": 17,
                    "color": "#ee230d",
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "会多出一个选项，在",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "以后的周目中",
                    "font_size": 17,
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "都要选择下面新出现的选项。第二周目的其他选项则可以随意选择，但要注意：",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "直到出现",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": " ",
                    "font_size": 17,
                    "color": "#ff654e",
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "‘预言火的灾难/预言水的灾难’ ",
                    "font_size": 17,
                    "color": "#ff654e",
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "时选择后者，然后进入到下一周目（下一次轮回）",
                    "font_size": 17,
                    "color": "#ff654e",
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 2,
            "pic": {
              "pics": [
                {
                  "url": "https://i0.hdslb.com/bfs/new_dyn/ccdace6dd77a8a466a529a738e4103221436440051.png",
                  "width": 553,
                  "height": 416,
                  "size": 242.0068359375
                }
              ],
              "style": 1
            }
          },
          {
            "para_type": 6,
            "format": {
              "list_format": {
                "level": 1,
                "order": 1
              }
            },
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "第三周目：顺着第二周目的选项去选，但是和",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "志摩一定",
                    "font_size": 17,
                    "color": "#ee230d",
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "要选择在外面，否则一定会触发",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "BADEND",
                    "font_size": 17,
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，之后会发现和",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "瑠依",
                    "font_size": 17,
                    "color": "#ee230d",
                    "style": {
                      "bold": true
                    }
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "的选项会多出一条：",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "将其强硬地拉至怀里",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，  选择该选项。",
                    "font_size": 17,
                    "style": {}
                  }
                }
              ]
            }
          },
          {
            "para_type": 2,
            "pic": {
              "pics": [
                {
                  "url": "https://i0.hdslb.com/bfs/new_dyn/c92fb364152bbbeb6cba38edd5eb77171436440051.png",
                  "width": 553,
                  "height": 415,
                  "size": 359.7353515625
                }
              ],
              "style": 1
