          },
          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "      之后的选项建议所有人内，",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "这是达成好结局的条件",
                    "font_size": 17,
                    "color": "#56c1fe",
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，在之后我们会遇到",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "绚花和雾子",
                    "font_size": 17,
                    "color": "#ee230d",
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "二选一        的选项，如果选择雾子则会直接gg ",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "由于绚花犹豫不决立场不坚定，把你给卖了，",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "☹",
                    "font_size": 17,
                    "style": {}
                  }
                }
