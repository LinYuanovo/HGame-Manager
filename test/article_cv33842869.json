          {
            "para_type": 1,
            "format": {},
            "text": {
              "nodes": [
                {
                  "node_type": 1,
                  "word": {
                    "words": "      所以要选择绚花",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "，不用担心，绚花完了之后就是雾子，不会少了你的",
                    "font_size": 17,
                    "style": {}
                  }
                },
                {
                  "node_type": 1,
                  "word": {
                    "words": "☺",
                    "font_size": 17,
                    "style": {}
                  }
                }
